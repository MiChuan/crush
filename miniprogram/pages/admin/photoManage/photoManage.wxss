page {
  min-height: 100%;
  background: #ffffff;
  color: #262626;
}

.page,
.page view,
.page image {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(36rpx + env(safe-area-inset-bottom));
}

.page-tools {
  min-height: 112rpx;
  padding: 12rpx 12rpx 12rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border: 1rpx solid #ececed;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 35, 34, 0.06);
}

.tools-title {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #242424;
  font-size: 30rpx;
  font-weight: 700;
}

.tools-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #d94335;
  font-size: 30rpx;
  background: #fff1ef;
  border-radius: 12rpx;
}

.add-btn {
  min-width: 196rpx;
  height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  flex-shrink: 0;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  background: #d94335;
  border: 1rpx solid #d94335;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 18rpx rgba(217, 67, 53, 0.18);
}

.add-btn .cuIcon-add {
  font-size: 26rpx;
  font-weight: 700;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-top: 20rpx;
}

.photo-cell {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  height: 220rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f2f3f5;
}

.photo-img {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 30rpx;
  background: rgba(0, 0, 0, 0.45);
  border-bottom-left-radius: 16rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.empty-icon {
  font-size: 120rpx;
  color: #dcdee0;
}

.empty-text {
  font-size: 26rpx;
  color: #969799;
  margin-top: 24rpx;
}
