.home-page {
  min-height: 100vh;
  background: var(--page-bg);
  padding-bottom: calc(env(safe-area-inset-bottom) + 140rpx);
}

/* 品牌横幅 */
.brand-hero {
  position: relative;
  height: 460rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.brand-backdrop {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, #1a1a1a 0%, #2d1f1f 40%, #4a2c2c 100%);
}

.brand-backdrop::after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 50% 80%, rgba(217, 67, 53, 0.28), transparent 60%);
}

.brand-content {
  position: relative;
  z-index: 1;
  text-align: center;
  color: #ffffff;
}

.brand-title {
  font-size: 96rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
  line-height: 1;
  text-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.35);
}

.brand-subtitle {
  font-size: 28rpx;
  letter-spacing: 6rpx;
  margin-top: 12rpx;
  opacity: 0.9;
}

.brand-slogan {
  font-size: 40rpx;
  letter-spacing: 16rpx;
  margin-top: 24rpx;
  opacity: 0.85;
}

/* 主卡片 */
.home-card {
  position: relative;
  z-index: 2;
  margin: -80rpx 30rpx 0;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 16rpx 50rpx rgba(27, 36, 48, 0.1);
  overflow: hidden;
}

.welcome-bar {
  background: linear-gradient(90deg, #ff8c3a 0%, #ff6b35 100%);
  padding: 20rpx 30rpx;
}

.welcome-label {
  color: #ffffff;
  font-size: 26rpx;
}

.member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx 30rpx;
  border-bottom: 1rpx solid var(--line-color);
}

.member-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.member-sub {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

.login-btn {
  background: linear-gradient(90deg, #ff8c3a 0%, #ff6b35 100%);
  color: #ffffff;
  font-size: 26rpx;
  padding: 14rpx 32rpx;
  border-radius: 32rpx;
  box-shadow: 0 6rpx 18rpx rgba(255, 107, 53, 0.22);
}

/* 入口网格 */
.action-grid {
  display: flex;
  gap: 24rpx;
  padding: 30rpx;
}

.action-card {
  flex: 1;
  background: #ffffff;
  border: 1rpx solid rgba(34, 37, 43, 0.06);
  border-radius: 24rpx;
  padding: 40rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 28rpx rgba(27, 36, 48, 0.05);
  transition: transform 0.15s;
}

.action-card:active {
  transform: scale(0.98);
}

.action-icon {
  font-size: 72rpx;
  color: var(--theme-color);
  line-height: 1;
}

.action-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-top: 20rpx;
}

.action-en {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
  letter-spacing: 2rpx;
}

/* 充值入口 */
.recharge-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 30rpx 30rpx;
  padding: 26rpx 30rpx;
  background: linear-gradient(90deg, #fff8f3 0%, #ffffff 100%);
  border: 1rpx solid rgba(217, 67, 53, 0.1);
  border-radius: 20rpx;
}

.recharge-left {
  display: flex;
  align-items: center;
}

.recharge-icon {
  font-size: 40rpx;
  color: var(--theme-color);
  margin-right: 16rpx;
}

.recharge-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-main);
}

.recharge-right {
  display: flex;
  align-items: center;
}

.recharge-tip {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-right: 8rpx;
}

.recharge-arrow {
  font-size: 24rpx;
  color: var(--text-muted);
}
